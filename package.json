{
  "name": "fleet-shift",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "csv-parse": "^7.0.3",
    "fastify": "^5.12.7",
    "saxes": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck:api": "tsc --noEmit -p apps/api/tsconfig.json",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "typecheck:core": "tsc --noEmit -p packages/core/tsconfig.json",
    "typecheck:data": "tsc --noEmit -p packages/data/tsconfig.json",
    "typecheck": "npm run typecheck:core && npm run typecheck:data && npm run typecheck:api && npm run typecheck:web",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "npm run db:generate -w @fleetshift/api",
    "db:migrate": "npm run db:migrate -w @fleetshift/api"
  }
}
